// Cloudflare Worker (free plan) that serves the showcase site at https://chat.lekopien.com
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lekopien-chat",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public" },
  "routes": [{ "pattern": "chat.lekopien.com", "custom_domain": true }]
}
